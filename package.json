{
  "name": "cfp-e-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run sync:apps-script && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "sync:apps-script": "node scripts/sync-apps-script.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run build && npm run test:browser",
    "format": "prettier --write . && npm run sync:apps-script"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
